<style>
    /* ============================================
           1. DESIGN TOKENS (CSS Variables)
           ============================================ */
    :root {
        --green: #1B4D3F;
        --green-light: #2a6b58;
        --green-dark: #122e25;
        --green-faint: #f0f5f3;
        --brown: #7C5C3E;
        --brown-light: #9b7455;
        --brown-faint: #f7f3ee;
        --white: #FFFFFF;
        --off-white: #F9F9F9;
        --border: #E2E2E2;
        --border-dark: #C8C8C8;
        --text: #1A1A1A;
        --text-muted: #6B6B6B;
        --text-light: #9A9A9A;
        --shadow-xs: 0 1px 3px rgba(0,0,0,.06);
        --shadow-sm: 0 2px 8px rgba(0,0,0,.08);
        --shadow-md: 0 6px 20px rgba(0,0,0,.10);
        --shadow-lg: 0 16px 48px rgba(0,0,0,.12);
        --radius: 0px;
        --font-serif: 'Playfair Display', Georgia, serif;
        --font-sans: 'DM Sans', system-ui, sans-serif;
        --transition: all .22s ease;
    }

    /* ============================================
           2. BASE RESET & GLOBAL STYLES
           ============================================ */
    *, *::before, *::after {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
        font-size: 16px;
    }

    body {
        font-family: var(--font-sans);
        background: var(--white);
        color: var(--text);
        min-height: 100vh;
        overflow-x: hidden;
        margin: 0;
        padding: 0;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    button {
        cursor: pointer;
        font-family: var(--font-sans);
    }

    /* ============================================
           3. ACCESSIBILITY
           ============================================ */
    .skip-link {
        position: absolute;
        top: -60px;
        left: 1rem;
        background: var(--green);
        color: var(--white);
        padding: .5rem 1rem;
        font-size: .85rem;
        z-index: 9999;
        transition: top .2s;
        text-decoration: none;
    }

        .skip-link:focus {
            top: 0;
        }

    /* ============================================
           4. PAGE HERO SECTION
           ============================================ */
    .page-hero {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        padding: 3rem 2rem 2.5rem;
        margin-bottom: 50px;
    }

    .page-hero-inner {
        max-width: 1320px;
        margin: 0 auto;
    }

    .page-eyebrow {
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--brown);
        margin-bottom: .5rem;
        display: block;
    }

    .page-hero h1 {
        font-family: var(--font-serif);
        font-size: clamp(1.6rem, 3.5vw, 2.4rem);
        font-weight: 600;
        color: var(--green-dark);
        margin-bottom: 0.5rem;
    }

    .page-hero p {
        color: var(--text-muted);
        font-size: .95rem;
        margin-top: .5rem;
        max-width: 540px;
        line-height: 1.65;
    }

    /* ============================================
           5. CONTACT GRID & ITEMS
           ============================================ */
    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
    }

    .contact-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.6rem;
    }

    .contact-icon {
        width: 44px;
        height: 44px;
        background: var(--green);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .contact-icon svg {
            width: 20px;
            height: 20px;
            stroke: #fff;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
        }

    .contact-text strong {
        display: block;
        font-size: .875rem;
        font-weight: 600;
        margin-bottom: .25rem;
    }

    .contact-text p {
        font-size: .83rem;
        color: var(--text-muted);
        line-height: 1.6;
    }

    /* ============================================
           6. FORM STYLES
           ============================================ */
    .form-group {
        margin-bottom: 1.2rem;
    }

    .form-label {
        display: block;
        font-size: .82rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: .4rem;
    }

    .form-input,
    .form-select,
    .form-textarea {
        width: 100%;
        padding: .75rem 1rem;
        border: 1.5px solid var(--border);
        font-family: var(--font-sans);
        font-size: .875rem;
        background: var(--white);
        color: var(--text);
        transition: var(--transition);
        outline: none;
        appearance: none;
    }

        .form-input:focus,
        .form-select:focus,
        .form-textarea:focus {
            border-color: var(--green);
            box-shadow: 0 0 0 3px rgba(27,77,63,.08);
        }

    .form-textarea {
        min-height: 110px;
        resize: vertical;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    /* ============================================
           7. BUTTONS
           ============================================ */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .75rem 1.75rem;
        font-size: .875rem;
        font-weight: 600;
        border: none;
        transition: var(--transition);
        cursor: pointer;
        letter-spacing: .02em;
        font-family: var(--font-sans);
    }

    .btn-primary {
        background: var(--green);
        color: var(--white);
    }

        .btn-primary:hover {
            background: var(--green-light);
        }
</style>


<div class="page" id="page-contact">
    <div class="page-hero">
        <div class="page-hero-inner">
            <span class="page-eyebrow">Get in Touch</span>
            <h1>Contact Us</h1>
            <p>We welcome enquiries from customers, producers, and anyone interested in what we do.</p>
        </div>
    </div>
    <section class="section">
        <div class="container">
            <div class="contact-grid">
