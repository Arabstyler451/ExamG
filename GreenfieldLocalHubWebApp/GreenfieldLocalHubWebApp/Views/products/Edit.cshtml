@model GreenfieldLocalHubWebApp.Models.products

@{
    ViewData["Title"] = "Edit Product";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />

<style>
    .glh-edit-root {
        --green:       #1B4D3F;
        --green-light: #2a6b58;
        --green-dark:  #122e25;
        --green-faint: #f0f5f3;
        --brown:       #7C5C3E;
        --brown-light: #9b7455;
        --white:       #FFFFFF;
        --off-white:   #F9F9F9;
        --border:      #E2E2E2;
        --border-dark: #C8C8C8;
        --text:        #1A1A1A;
        --text-muted:  #6B6B6B;
        --text-light:  #9A9A9A;
        --font-serif:  'Playfair Display', Georgia, serif;
        --font-sans:   'DM Sans', system-ui, sans-serif;
        --transition:  all .22s ease;
        font-family: var(--font-sans);
        color: var(--text);
    }

    /* ── Page hero ── */
    .glh-edit-hero {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        padding: 2.5rem 0 2rem;
        margin-bottom: 0;
    }
    .glh-edit-hero-inner {
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 2rem;
    }
    .glh-edit-eyebrow {
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--brown);
        margin-bottom: .5rem;
        display: block;
    }
    .glh-edit-hero h1 {
        font-family: var(--font-serif);
        font-size: clamp(1.6rem, 3.5vw, 2.4rem);
        font-weight: 600;
        color: var(--green-dark);
        margin: 0;
    }

    /* ── Breadcrumb ── */
    .glh-breadcrumb {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .78rem;
        color: var(--text-light);
        margin-bottom: .75rem;
        flex-wrap: wrap;
    }
    .glh-breadcrumb a { color: var(--text-muted); text-decoration: none; transition: color .2s; }
    .glh-breadcrumb a:hover { color: var(--green); }
    .glh-breadcrumb-sep { color: var(--border-dark); }

    /* ── Section wrapper ── */
    .glh-edit-section {
        max-width: 1320px;
        margin: 0 auto;
        padding: 3.5rem 2rem;
    }

    /* ── Two column grid ── */
    .glh-edit-grid {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 2.5rem;
        align-items: start;
    }

    /* ── Card ── */
    .glh-card {
        background: var(--white);
        border: 1px solid var(--border);
        margin-bottom: 1.5rem;
        overflow: hidden;
    }
    .glh-card-header {
        padding: 1.2rem 1.6rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: .75rem;
    }
    .glh-card-header-num {
        width: 26px;
        height: 26px;
        background: var(--green);
        color: #fff;
        font-size: .72rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .glh-card-header h2 {
        font-family: var(--font-serif);
        font-size: 1.05rem;
        color: var(--green-dark);
        font-weight: 600;
        margin: 0;
    }
    .glh-card-body { padding: 1.6rem; }

    /* ── Form elements ── */
    .glh-form-group { margin-bottom: 1.2rem; }
    .glh-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
    .glh-form-label {
        display: block;
        font-size: .82rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: .4rem;
    }
    .glh-form-hint {
        font-size: .75rem;
        color: var(--text-muted);
        margin-top: .3rem;
    }
    .glh-form-input,
    .glh-form-select,
    .glh-form-textarea {
        width: 100%;
        padding: .75rem 1rem;
        border: 1.5px solid var(--border);
        font-family: var(--font-sans);
        font-size: .875rem;
        background: var(--white);
        color: var(--text);
        transition: var(--transition);
        outline: none;
        appearance: none;
        box-sizing: border-box;
    }
    .glh-form-input:focus,
    .glh-form-select:focus,
    .glh-form-textarea:focus {
        border-color: var(--green);
        box-shadow: 0 0 0 3px rgba(27,77,63,.08);
    }
    .glh-form-textarea { min-height: 110px; resize: vertical; }
    .glh-select-wrap { position: relative; }
    .glh-select-wrap::after {
        content: '▾';
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        pointer-events: none;
        font-size: .8rem;
    }
    .glh-field-error {
        display: block;
        font-size: .75rem;
        color: #a0281e;
        margin-top: .3rem;
    }
    .glh-alert-error {
        background: #fde8e8;
        border-left: 3px solid #a0281e;
        color: #a0281e;
        padding: .85rem 1.1rem;
        font-size: .83rem;
        margin-bottom: 1.4rem;
    }

    /* ── Toggle switch for availability ── */
    .glh-toggle-wrap {
        display: flex;
        align-items: center;
        gap: .85rem;
        padding: .85rem 1rem;
        border: 1.5px solid var(--border);
        background: var(--off-white);
    }
    .glh-toggle {
        position: relative;
        width: 42px;
        height: 24px;
        flex-shrink: 0;
    }
    .glh-toggle input {
        opacity: 0;
        width: 0;
        height: 0;
        position: absolute;
    }
    .glh-toggle-slider {
        position: absolute;
        inset: 0;
        background: var(--border-dark);
        transition: var(--transition);
        cursor: pointer;
    }
    .glh-toggle-slider::before {
        content: '';
        position: absolute;
        width: 18px;
        height: 18px;
        left: 3px;
        top: 3px;
        background: white;
        transition: var(--transition);
    }
    .glh-toggle input:checked + .glh-toggle-slider {
        background: var(--green);
    }
    .glh-toggle input:checked + .glh-toggle-slider::before {
        transform: translateX(18px);
    }
    .glh-toggle-label {
        font-size: .875rem;
        color: var(--text);
        font-weight: 500;
    }
    .glh-toggle-sub {
        font-size: .75rem;
        color: var(--text-muted);
        margin-top: .15rem;
    }

    /* ── Buttons ── */
    .glh-btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .8rem 1.75rem;
        font-size: .875rem;
        font-weight: 600;
        border: none;
        transition: var(--transition);
        cursor: pointer;
        letter-spacing: .02em;
        font-family: var(--font-sans);
        text-decoration: none;
    }
    .glh-btn-primary { background: var(--green); color: #fff; width: 100%; justify-content: center; margin-bottom: .65rem; }
    .glh-btn-primary:hover { background: var(--green-light); color: #fff; }
    .glh-btn-ghost {
        background: transparent;
        color: var(--text);
        border: 1.5px solid var(--border);
        width: 100%;
        justify-content: center;
    }
    .glh-btn-ghost:hover { border-color: var(--green); color: var(--green); }

    /* ── Summary sidebar ── */
    .glh-summary-card {
        background: var(--white);
        border: 1px solid var(--border);
        padding: 1.8rem;
        position: sticky;
        top: 90px;
    }
    .glh-summary-title {
        font-family: var(--font-serif);
        font-size: 1.2rem;
        color: var(--green-dark);
        margin-bottom: 1.2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border);
    }
    .glh-summary-row {
        display: flex;
        justify-content: space-between;
        font-size: .82rem;
        padding: .45rem 0;
        color: var(--text-muted);
        border-bottom: 1px solid var(--border);
    }
    .glh-summary-row:last-of-type { border-bottom: none; }
    .glh-summary-row span:last-child {
        font-weight: 600;
        color: var(--text);
    }
    .glh-info-box {
        background: var(--green-faint);
        border: 1px solid rgba(27,77,63,.15);
        padding: 1rem 1.2rem;
        font-size: .82rem;
        line-height: 1.65;
        color: var(--text-muted);
        margin-top: 1.5rem;
    }
    .glh-info-box strong {
        display: block;
        color: var(--green-dark);
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: .3rem;
    }

    /* ── Responsive ── */
    @@media (max-width: 900px) {
        .glh-edit-grid { grid-template-columns: 1fr; }
        .glh-summary-card { position: static; }
    }
    @@media (max-width: 540px) {
        .glh-edit-section { padding: 2rem 1rem; }
        .glh-form-row { grid-template-columns: 1fr; }
        .glh-card-body { padding: 1.2rem; }
    }
</style>

<div class="glh-edit-root">

    <!-- PAGE HERO -->
    <div class="glh-edit-hero">
        <div class="glh-edit-hero-inner">
            <nav class="glh-breadcrumb" aria-label="Breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <span class="glh-breadcrumb-sep">›</span>
                <a asp-controller="products" asp-action="Index">Shop</a>
                <span class="glh-breadcrumb-sep">›</span>
                <a asp-controller="products" asp-action="Details" asp-route-id="@Model.productsId">@Model.productName</a>
                <span class="glh-breadcrumb-sep">›</span>
                <span aria-current="page">Edit</span>
            </nav>
            <span class="glh-edit-eyebrow">Product Management</span>
            <h1>Edit Product</h1>
        </div>
    </div>

    <div class="glh-edit-section">
        <form asp-action="Edit" method="post" id="editForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="productsId" />
            <div asp-validation-summary="ModelOnly" class="glh-alert-error"></div>

            <div class="glh-edit-grid">

                <!-- LEFT COLUMN -->
                <div>

                    <!-- Card 1: Core Details -->
                    <div class="glh-card">
                        <div class="glh-card-header">
                            <span class="glh-card-header-num">1</span>
                            <h2>Product Details</h2>
                        </div>
                        <div class="glh-card-body">

                            <div class="glh-form-group">
                                <label asp-for="productName" class="glh-form-label">Product Name</label>
                                <input asp-for="productName" class="glh-form-input" placeholder="e.g. Organic Free Range Eggs" />
                                <span asp-validation-for="productName" class="glh-field-error"></span>
                            </div>

                            <div class="glh-form-group">
                                <label asp-for="productDescription" class="glh-form-label">Description</label>
                                <textarea asp-for="productDescription" class="glh-form-textarea"
                                          placeholder="Describe your product…"></textarea>
                                <span asp-validation-for="productDescription" class="glh-field-error"></span>
                            </div>

                            <div class="glh-form-row">
                                <div class="glh-form-group">
                                    <label asp-for="productPrice" class="glh-form-label">Price (£)</label>
                                    <input asp-for="productPrice" type="number" step="0.01" min="0"
                                           class="glh-form-input" placeholder="0.00" />
                                    <span asp-validation-for="productPrice" class="glh-field-error"></span>
                                </div>
                                <div class="glh-form-group">
                                    <label asp-for="productUnit" class="glh-form-label">Unit</label>
                                    <input asp-for="productUnit" class="glh-form-input" placeholder="e.g. kg, litre, each" />
                                    <span asp-validation-for="productUnit" class="glh-field-error"></span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Card 2: Stock & Category -->
                    <div class="glh-card">
                        <div class="glh-card-header">
                            <span class="glh-card-header-num">2</span>
                            <h2>Stock &amp; Category</h2>
                        </div>
                        <div class="glh-card-body">

                            <div class="glh-form-row">
                                <div class="glh-form-group">
                                    <label asp-for="stockQuantity" class="glh-form-label">Stock Quantity</label>
                                    <input asp-for="stockQuantity" type="number" min="0"
                                           class="glh-form-input" placeholder="0" />
                                    <span asp-validation-for="stockQuantity" class="glh-field-error"></span>
                                </div>
                                <div class="glh-form-group">
                                    <label asp-for="categoriesId" class="glh-form-label">Category</label>
                                    <div class="glh-select-wrap">
                                        @Html.DropDownListFor(
                                            m => m.categoriesId,
                                            (SelectList)ViewData["categoriesId"],
                                            "— Select category —",
                                            new { @class = "glh-form-select" })
                                    </div>
                                    <span asp-validation-for="categoriesId" class="glh-field-error"></span>
                                </div>
                            </div>

                            <div class="glh-form-group">
                                <label class="glh-form-label">Availability</label>
                                <div class="glh-toggle-wrap">
                                    <label class="glh-toggle">
                                        <input asp-for="productAvailability" type="checkbox" />
                                        <span class="glh-toggle-slider"></span>
                                    </label>
                                    <div>
                                        <div class="glh-toggle-label">Available for purchase</div>
                                        <div class="glh-toggle-sub">Toggle off to hide this product from the shop</div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Card 3: Image -->
                    <div class="glh-card">
                        <div class="glh-card-header">
                            <span class="glh-card-header-num">3</span>
                            <h2>Product Image</h2>
                        </div>
                        <div class="glh-card-body">
                            <div class="glh-form-group">
                                <label asp-for="productImage" class="glh-form-label">Image URL</label>
                                <input asp-for="productImage" class="glh-form-input"
                                       placeholder="https://example.com/image.jpg"
                                       oninput="previewImage(this.value)" />
                                <p class="glh-form-hint">Paste a direct link to your product image.</p>
                                <span asp-validation-for="productImage" class="glh-field-error"></span>
                            </div>
                            <div id="imgPreviewWrap" style="margin-top:.75rem;display:@(!string.IsNullOrEmpty(Model.productImage) ? "block" : "none")">
                                <img id="imgPreview"
                                     src="@Model.productImage"
                                     alt="Preview"
                                     style="width:100%;max-height:220px;object-fit:cover;border:1px solid var(--border);"
                                     onerror="this.style.display='none'" />
                            </div>
                        </div>
                    </div>

                </div>

                <!-- RIGHT COLUMN: SUMMARY SIDEBAR -->
                <aside>
                    <div class="glh-summary-card">
                        <h2 class="glh-summary-title">Current Values</h2>

                        <div class="glh-summary-row">
                            <span>Product</span>
                            <span>@Model.productName</span>
                        </div>
                        <div class="glh-summary-row">
                            <span>Price</span>
                            <span>£@Model.productPrice.ToString("0.00")</span>
                        </div>
                        <div class="glh-summary-row">
                            <span>Stock</span>
                            <span>@Model.stockQuantity units</span>
                        </div>
                        <div class="glh-summary-row">
                            <span>Unit</span>
                            <span>@(Model.productUnit ?? "—")</span>
                        </div>
                        <div class="glh-summary-row">
                            <span>Status</span>
                            <span>@(Model.productAvailability ? "Available" : "Hidden")</span>
                        </div>

                        <div style="margin-top:1.5rem;">
                            <button type="submit" class="glh-btn glh-btn-primary">
                                Save Changes
                            </button>
                            <a asp-controller="producerDashboard" asp-action="Index"
                               asp-route-activeTab="products"
                               class="glh-btn glh-btn-ghost">
                                Cancel
                            </a>
                        </div>

                        <div class="glh-info-box">
                            <strong>Note</strong>
                            Changes will be visible to customers immediately after saving.
                        </div>
                    </div>
                </aside>

            </div>
        </form>
    </div>

</div>

<script>
    function previewImage(url) {
        const wrap = document.getElementById('imgPreviewWrap');
        const img  = document.getElementById('imgPreview');
        if (url) {
            wrap.style.display = 'block';
            img.style.display  = 'block';
            img.src = url;
        } else {
            wrap.style.display = 'none';
        }
    }
</script>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}