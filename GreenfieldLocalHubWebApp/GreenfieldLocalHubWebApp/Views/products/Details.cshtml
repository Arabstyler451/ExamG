@model GreenfieldLocalHubWebApp.ViewModels.productDetailsViewModel

@{
    ViewData["Title"] = Model.Product.productName;

    var avail = Model.Product.productAvailability;
    string availClass = avail ? "in" : "out";
    string availLabel = avail ? "In Stock" : "Out of Stock";
}

@* ── Google Fonts ── *@
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />

<style>
    /* ── Design tokens (scoped to this view) ── */
    .glh-detail-root {
        --green:        #1B4D3F;
        --green-light:  #2a6b58;
        --green-dark:   #122e25;
        --green-faint:  #f0f5f3;
        --brown:        #7C5C3E;
        --brown-light:  #9b7455;
        --white:        #FFFFFF;
        --off-white:    #F9F9F9;
        --border:       #E2E2E2;
        --border-dark:  #C8C8C8;
        --text:         #1A1A1A;
        --text-muted:   #6B6B6B;
        --text-light:   #9A9A9A;
        --shadow-sm:    0 2px 8px rgba(0,0,0,.08);
        --shadow-md:    0 6px 20px rgba(0,0,0,.10);
        --font-serif:   'Playfair Display', Georgia, serif;
        --font-sans:    'DM Sans', system-ui, sans-serif;
        --transition:   all .22s ease;
        font-family: var(--font-sans);
        color: var(--text);
    }

    /* ── Breadcrumb ── */
    .glh-breadcrumb {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .78rem;
        color: var(--text-light);
        padding: 1.4rem 0 .5rem;
        flex-wrap: wrap;
    }
    .glh-breadcrumb a { color: var(--text-muted); text-decoration: none; transition: color .2s; }
    .glh-breadcrumb a:hover { color: var(--green); }
    .glh-breadcrumb-sep { color: var(--border-dark); }

    /* ── Detail layout ── */
    .glh-detail-layout {
        display: grid;
        grid-template-columns: 1fr 1.1fr;
        gap: 3rem;
        align-items: start;
        margin-top: 2rem;
    }

    /* ── Image column ── */
    .glh-detail-img-main {
        width: 100%;
        aspect-ratio: 1;
        background: #E8E8E8;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    .glh-detail-img-main img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .glh-detail-img-placeholder {
        color: #999;
        font-size: .8rem;
        font-weight: 500;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    /* ── Info column ── */
    .glh-detail-eyebrow {
        font-size: .72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: var(--brown);
        margin-bottom: .5rem;
    }
    .glh-detail-title {
        font-family: var(--font-serif);
        font-size: 2rem;
        color: var(--green-dark);
        margin-bottom: .6rem;
        line-height: 1.2;
    }
    .glh-detail-tags {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        margin-bottom: 1.2rem;
        align-items: center;
    }
    .glh-tag {
        background: var(--off-white);
        color: var(--text-muted);
        font-size: .7rem;
        padding: .2rem .65rem;
        border: 1px solid var(--border);
        font-weight: 500;
    }
    .glh-avail {
        font-size: .72rem;
        font-weight: 600;
        padding: .25rem .65rem;
        letter-spacing: .04em;
    }
    .glh-avail.in  { background: #eaf4ef; color: #1a6b40; }
    .glh-avail.low { background: #fdf3e7; color: #9a5a10; }
    .glh-avail.out { background: #fde8e8; color: #a0281e; }

    .glh-detail-price {
        font-family: var(--font-serif);
        font-size: 1.75rem;
        color: var(--green);
        margin: .8rem 0;
    }
    .glh-detail-price small {
        font-family: var(--font-sans);
        font-size: .85rem;
        color: var(--text-muted);
        font-weight: 400;
    }
    .glh-detail-desc {
        font-size: .93rem;
        color: var(--text-muted);
        line-height: 1.75;
        margin-bottom: 1.4rem;
    }

    /* ── Traceability box ── */
    .glh-trace-box {
        background: var(--green-faint);
        border: 1px solid rgba(27,77,63,.15);
        padding: 1.2rem;
        margin-bottom: 1.4rem;
        font-size: .83rem;
        line-height: 1.65;
        color: var(--text-muted);
    }
    .glh-trace-box strong {
        color: var(--green-dark);
        display: block;
        margin-bottom: .4rem;
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    /* ── Add to basket row ── */
    .glh-detail-add {
        display: flex;
        align-items: center;
        gap: .75rem;
        flex-wrap: wrap;
    }
    .glh-qty-ctrl { display: flex; align-items: center; gap: .4rem; }
    .glh-qty-btn {
        width: 34px; height: 34px;
        border: 1.5px solid var(--border);
        background: var(--white);
        font-size: 1.1rem;
        font-weight: 500;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        transition: var(--transition);
        font-family: var(--font-sans);
    }
    .glh-qty-btn:hover { border-color: var(--green); color: var(--green); }
    .glh-qty-input {
        width: 54px;
        text-align: center;
        padding: .55rem .5rem;
        border: 1.5px solid var(--border);
        font-size: .95rem;
        font-family: var(--font-sans);
    }
    .glh-qty-input:focus { outline: none; border-color: var(--green); }

    /* ── Buttons ── */
    .glh-btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .75rem 1.75rem;
        font-size: .875rem;
        font-weight: 600;
        border: none;
        transition: var(--transition);
        cursor: pointer;
        letter-spacing: .02em;
        font-family: var(--font-sans);
        text-decoration: none;
    }
    .glh-btn-primary { background: var(--green); color: #fff; }
    .glh-btn-primary:hover { background: var(--green-light); color: #fff; }
    .glh-btn-outline {
        background: transparent;
        color: var(--green);
        border: 1.5px solid var(--green);
    }
    .glh-btn-outline:hover { background: var(--green); color: #fff; }
    .glh-btn-ghost {
        background: transparent;
        color: var(--text);
        border: 1.5px solid var(--border);
    }
    .glh-btn-ghost:hover { border-color: var(--green); color: var(--green); }
    .glh-btn-lg { padding: .9rem 2.2rem; font-size: .95rem; }
    .glh-btn-sm { padding: .5rem 1.1rem; font-size: .8rem; }

    /* ── Shipping strip ── */
    .glh-detail-shipping {
        display: flex;
        gap: 1.5rem;
        margin-top: 1.4rem;
        padding-top: 1.2rem;
        border-top: 1px solid var(--border);
        font-size: .78rem;
        color: var(--text-muted);
        flex-wrap: wrap;
    }

    /* ── "You May Also Like" ── */
    .glh-also-like {
        margin-top: 4rem;
        padding-top: 3rem;
        border-top: 1px solid var(--border);
    }
    .glh-also-like-title {
        font-family: var(--font-serif);
        font-size: 1.4rem;
        color: var(--green-dark);
        margin-bottom: 1.5rem;
    }
    .glh-product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 1.5rem;
    }

    /* ── Product card ── */
    .glh-product-card {
        background: var(--white);
        border: 1px solid var(--border);
        transition: var(--transition);
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        display: block;
    }
    .glh-product-card:hover { border-color: var(--green); box-shadow: var(--shadow-md); }
    .glh-product-card:hover .glh-pc-img-inner { transform: scale(1.03); }
    .glh-pc-img { overflow: hidden; }
    .glh-pc-img-inner {
        width: 100%;
        aspect-ratio: 1;
        transition: transform .4s ease;
        background: #E8E8E8;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    .glh-pc-img-inner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .glh-pc-img-placeholder {
        color: #999;
        font-size: .7rem;
        font-weight: 500;
        letter-spacing: .06em;
        text-transform: uppercase;
    }
    .glh-pc-body { padding: 1.1rem 1.2rem 1.3rem; }
    .glh-pc-producer {
        font-size: .68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--brown);
        margin-bottom: .3rem;
    }
    .glh-pc-name {
        font-weight: 600;
        font-size: .95rem;
        margin-bottom: .3rem;
        color: var(--text);
        line-height: 1.3;
    }
    .glh-pc-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: .9rem;
    }
    .glh-pc-price {
        font-family: var(--font-serif);
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--green);
    }
    .glh-pc-price small {
        font-family: var(--font-sans);
        font-size: .7rem;
        color: var(--text-muted);
        font-weight: 400;
    }

    /* ── Admin links bar ── */
    .glh-admin-bar {
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--border);
        display: flex;
        gap: 1rem;
        font-size: .83rem;
    }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .glh-detail-layout { grid-template-columns: 1fr; }
        .glh-product-grid  { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
    }
</style>

<div class="glh-detail-root">
    <div class="container-fluid px-4 px-md-5" style="max-width:1320px;margin:0 auto;">

        <!-- BREADCRUMB -->
        <nav class="glh-breadcrumb" aria-label="Breadcrumb">
            <a asp-action="Index" asp-controller="Home">Home</a>
            <span class="glh-breadcrumb-sep">›</span>
            <a asp-action="Index">Shop</a>
            <span class="glh-breadcrumb-sep">›</span>
            <span aria-current="page">@Model.Product.productName</span>
        </nav>

        <!-- MAINT DETAIL GRID -->
        <div class="glh-detail-layout">

            <!-- LEFT IMAGE -->
            <div>
                <div class="glh-detail-img-main">
                    @if (!string.IsNullOrWhiteSpace(Model.Product.productImage))
                    {
                        <img src="@Model.Product.productImage"
                             alt="@Model.Product.productName"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                        <span class="glh-detail-img-placeholder" style="display:none;">Image</span>
                    }
                    else
                    {
                        <span class="glh-detail-img-placeholder">Image</span>
                    }
                </div>
            </div>

            <!-- YOU MAY ALSO LIKE SECTION -->
            <div>
                <p class="glh-detail-eyebrow">
                    @(Model.Product.producers?.producerName ?? "Local Producer")
                    @if (Model.Product.categories != null)
                    {
                        <text> · @Model.Product.categories.categoryName</text>
                    }
                </p>

                <h1 class="glh-detail-title">@Model.Product.productName</h1>

                <div class="glh-detail-tags">
                    <span class="glh-avail @availClass">@availLabel</span>
                </div>

                <p class="glh-detail-price">
                    @Model.Product.productPrice.ToString("C")
                </p>

                <p class="glh-detail-desc">
                    @Model.Product.productDescription
                </p>

                <!-- TRACEABILITY / STOCK INFO -->
                <div class="glh-trace-box">
                    <strong>Stock Information</strong>
                    @Model.Product.stockQuantity unit@(Model.Product.stockQuantity == 1 ? "" : "s") currently available.
                    @if (Model.Product.producers != null)
                    {
                        <p>Supplied by: @(Model.Product.producers.producerName == null ? "NULL" : Model.Product.producers.producerName)</p>
                    }
                </div>

<!-- ADD TO CART -->
<form asp-controller="shoppingCartItems" asp-action="Create" method="post">
    <input type="hidden" name="productsId" value="@Model.Product.productsId" />

    @if (Model.Product.stockQuantity > 0)
    {
        <div class="glh-detail-add">
            <div class="glh-qty-ctrl">
                <button type="button" class="glh-qty-btn" onclick="glhAdjustQty(-1)" aria-label="Decrease quantity">−</button>
                <input type="number"
                       id="glhQty"
                       name="quantity"
                       value="1"
                       min="1"
                       max="@Model.Product.stockQuantity"
                       class="glh-qty-input"
                       aria-label="Quantity" />
                <button type="button" class="glh-qty-btn" onclick="glhAdjustQty(1)" aria-label="Increase quantity">+</button>
            </div>
            <button type="submit" class="glh-btn glh-btn-primary glh-btn-lg">
                Add to Cart
            </button>
        </div>
    }
    else
    {
        <button type="button" class="glh-btn glh-btn-ghost glh-btn-lg" disabled style="opacity:.5;cursor:not-allowed;">
            Out of Stock
        </button>
    }
</form>
                

                <div class="glh-detail-shipping">
                    <span>Home Delivery available</span>
                    <span>Click &amp; Collect at GLH Hub</span>
                    <span>Order by 8pm for next-day</span>
                </div>
            </div>
        </div>


        @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
        {
            <div class="glh-also-like">
                <h2 class="glh-also-like-title">You May Also Like</h2>
                <div class="glh-product-grid">
                    @foreach (var related in Model.RelatedProducts)
                    {
                        string rAvailClass = related.productAvailability ? "in" : "out";
                        string rAvailLabel = related.productAvailability ? "In Stock" : "Out of Stock";

                        <a class="glh-product-card"
                           asp-action="Details"
                           asp-route-id="@related.productsId"
                           aria-label="View @related.productName">
                            <div class="glh-pc-img">
                                <div class="glh-pc-img-inner">
                                    @if (!string.IsNullOrWhiteSpace(related.productImage))
                                    {
                                        <img src="@related.productImage"
                                             alt="@related.productName"
                                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                        <span class="glh-pc-img-placeholder" style="display:none;">Image</span>
                                    }
                                    else
                                    {
                                        <span class="glh-pc-img-placeholder">Image</span>
                                    }
                                </div>
                            </div>
                            <div class="glh-pc-body">
                                @if (related.producers != null)
                                {
                                    <p class="glh-pc-producer">@related.producers.producerName</p>
                                }
                                <h3 class="glh-pc-name">@related.productName</h3>
                                <div class="glh-pc-footer">
                                    <span class="glh-pc-price">@related.productPrice.ToString("C")</span>
                                    <span class="glh-avail @rAvailClass">@rAvailLabel</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }

        <!-- Only allows producers, admin and developer to manage the products-->
        <div class="glh-admin-bar">
            @if (User.IsInRole("Admin") || User.IsInRole("Developer") || (Model.Product.producers != null && !string.IsNullOrEmpty(User.Identity?.Name) && string.Equals(User.Identity.Name, Model.Product.producers.producerName, System.StringComparison.OrdinalIgnoreCase)))
            {
                <a asp-action="Edit" asp-route-id="@Model.Product.productsId"
                   class="glh-btn glh-btn-ghost glh-btn-sm">Edit</a>
                   <a asp-action="Delete" asp-route-id="@Model.Product.productsId"
                   class="glh-btn glh-btn-ghost glh-btn-sm">Delete</a>
            }
            <a asp-action="Index" class="glh-btn glh-btn-ghost glh-btn-sm">Back to shop</a>
        </div>

    </div>
</div>

<script>
    function glhAdjustQty(delta) {
        const input = document.getElementById('glhQty');
        if (!input) return;
        const max = parseInt(input.max) || 20;
        input.value = Math.max(1, Math.min(max, parseInt(input.value) + delta));
    }
</script>
