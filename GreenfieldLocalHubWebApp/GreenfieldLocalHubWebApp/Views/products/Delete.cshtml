@model GreenfieldLocalHubWebApp.Models.products

@{
    ViewData["Title"] = "Delete Product";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />

<style>
    .glh-delete-root {
        --green:       #1B4D3F;
        --green-light: #2a6b58;
        --green-dark:  #122e25;
        --green-faint: #f0f5f3;
        --brown:       #7C5C3E;
        --white:       #FFFFFF;
        --off-white:   #F9F9F9;
        --border:      #E2E2E2;
        --border-dark: #C8C8C8;
        --text:        #1A1A1A;
        --text-muted:  #6B6B6B;
        --text-light:  #9A9A9A;
        --red:         #a0281e;
        --red-faint:   #fde8e8;
        --font-serif:  'Playfair Display', Georgia, serif;
        --font-sans:   'DM Sans', system-ui, sans-serif;
        --transition:  all .22s ease;
        font-family: var(--font-sans);
        color: var(--text);
    }

    /* ── Hero ── */
    .glh-hero {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        padding: 2.5rem 0 2rem;
    }
    .glh-hero-inner {
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 2rem;
    }
    .glh-eyebrow {
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--red);
        margin-bottom: .5rem;
        display: block;
    }
    .glh-hero h1 {
        font-family: var(--font-serif);
        font-size: clamp(1.6rem, 3.5vw, 2.4rem);
        font-weight: 600;
        color: var(--green-dark);
        margin: 0;
    }

    /* ── Breadcrumb ── */
    .glh-breadcrumb {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .78rem;
        color: var(--text-light);
        margin-bottom: .75rem;
        flex-wrap: wrap;
    }
    .glh-breadcrumb a { color: var(--text-muted); text-decoration: none; transition: color .2s; }
    .glh-breadcrumb a:hover { color: var(--green); }
    .glh-breadcrumb-sep { color: var(--border-dark); }

    /* ── Section ── */
    .glh-section {
        max-width: 860px;
        margin: 0 auto;
        padding: 3.5rem 2rem;
    }

    /* ── Warning banner ── */
    .glh-warning-banner {
        background: var(--red-faint);
        border: 1px solid rgba(160,40,30,.2);
        border-left: 4px solid var(--red);
        padding: 1.2rem 1.4rem;
        margin-bottom: 2rem;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }
    .glh-warning-icon {
        width: 36px;
        height: 36px;
        background: var(--red);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .glh-warning-icon svg {
        width: 18px;
        height: 18px;
        stroke: #fff;
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
    }
    .glh-warning-text strong {
        display: block;
        font-size: .9rem;
        font-weight: 700;
        color: var(--red);
        margin-bottom: .2rem;
    }
    .glh-warning-text p {
        font-size: .83rem;
        color: #7a2018;
        line-height: 1.55;
        margin: 0;
    }

    /* ── Product card ── */
    .glh-product-card {
        background: var(--white);
        border: 1px solid var(--border);
        display: grid;
        grid-template-columns: 160px 1fr;
        gap: 0;
        margin-bottom: 2rem;
        overflow: hidden;
    }
    .glh-product-img {
        width: 160px;
        height: 160px;
        object-fit: cover;
        display: block;
    }
    .glh-product-img-placeholder {
        width: 160px;
        height: 160px;
        background: var(--off-white);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-light);
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .06em;
        border-right: 1px solid var(--border);
    }
    .glh-product-info {
        padding: 1.4rem 1.6rem;
        border-left: 1px solid var(--border);
    }
    .glh-product-category {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .1em;
        color: var(--brown);
        margin-bottom: .3rem;
    }
    .glh-product-name {
        font-family: var(--font-serif);
        font-size: 1.35rem;
        color: var(--green-dark);
        margin-bottom: .75rem;
        line-height: 1.25;
    }
    .glh-meta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .5rem .5rem;
    }
    .glh-meta-item {
        font-size: .8rem;
    }
    .glh-meta-label {
        color: var(--text-light);
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .07em;
        display: block;
        margin-bottom: .15rem;
    }
    .glh-meta-value {
        color: var(--text);
        font-weight: 500;
    }
    .glh-avail-pill {
        display: inline-block;
        padding: .2rem .65rem;
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .glh-avail-pill.in  { background: #eaf4ef; color: #1a6b40; }
    .glh-avail-pill.out { background: var(--red-faint); color: var(--red); }

    /* ── Action row ── */
    .glh-action-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .glh-btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .8rem 1.75rem;
        font-size: .875rem;
        font-weight: 600;
        border: none;
        transition: var(--transition);
        cursor: pointer;
        letter-spacing: .02em;
        font-family: var(--font-sans);
        text-decoration: none;
    }
    .glh-btn-danger {
        background: var(--red);
        color: #fff;
    }
    .glh-btn-danger:hover { background: #7a2018; color: #fff; }
    .glh-btn-ghost {
        background: transparent;
        color: var(--text);
        border: 1.5px solid var(--border);
    }
    .glh-btn-ghost:hover { border-color: var(--green); color: var(--green); }

    @@media (max-width: 540px) {
        .glh-product-card { grid-template-columns: 1fr; }
        .glh-product-img,
        .glh-product-img-placeholder { width: 100%; height: 200px; }
        .glh-product-info { border-left: none; border-top: 1px solid var(--border); }
        .glh-section { padding: 2rem 1rem; }
    }
</style>

<div class="glh-delete-root">

    <!-- PAGE HERO -->
    <div class="glh-hero">
        <div class="glh-hero-inner">
            <nav class="glh-breadcrumb" aria-label="Breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <span class="glh-breadcrumb-sep">›</span>
                <a asp-controller="producerDashboard" asp-action="Index"
                   asp-route-activeTab="products">Dashboard</a>
                <span class="glh-breadcrumb-sep">›</span>
                <span aria-current="page">Delete Product</span>
            </nav>
            <span class="glh-eyebrow">Danger Zone</span>
            <h1>Delete Product</h1>
        </div>
    </div>

    <div class="glh-section">

        <!-- WARNING BANNER -->
        <div class="glh-warning-banner" role="alert">
            <div class="glh-warning-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 9v4M12 17h.01"/>
                    <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                </svg>
            </div>
            <div class="glh-warning-text">
                <strong>This action cannot be undone</strong>
                <p>Permanently deleting this product will remove it from the shop and all associated data. Please review the details below before confirming.</p>
            </div>
        </div>

        <!-- PRODUCT PREVIEW CARD -->
        <div class="glh-product-card">
            @if (!string.IsNullOrEmpty(Model.productImage))
            {
                <img src="@Model.productImage"
                     alt="@Model.productName"
                     class="glh-product-img"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                <div class="glh-product-img-placeholder" style="display:none;">No Image</div>
            }
            else
            {
                <div class="glh-product-img-placeholder">No Image</div>
            }

            <div class="glh-product-info">
                @if (Model.categories != null)
                {
                    <p class="glh-product-category">@Model.categories.categoryName</p>
                }
                <h2 class="glh-product-name">@Model.productName</h2>

                <div class="glh-meta-grid">
                    <div class="glh-meta-item">
                        <span class="glh-meta-label">Price</span>
                        <span class="glh-meta-value">£@Model.productPrice.ToString("0.00") / @(Model.productUnit ?? "unit")</span>
                    </div>
                    <div class="glh-meta-item">
                        <span class="glh-meta-label">Stock</span>
                        <span class="glh-meta-value">@Model.stockQuantity units</span>
                    </div>
                    <div class="glh-meta-item">
                        <span class="glh-meta-label">Producer</span>
                        <span class="glh-meta-value">@(Model.producers?.producerName ?? "—")</span>
                    </div>
                    <div class="glh-meta-item">
                        <span class="glh-meta-label">Availability</span>
                        <span class="glh-avail-pill @(Model.productAvailability ? "in" : "out")">
                            @(Model.productAvailability ? "Available" : "Hidden")
                        </span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.productDescription))
                {
                    <p style="font-size:.83rem;color:var(--text-muted);margin-top:1rem;
                              line-height:1.65;border-top:1px solid var(--border);padding-top:.9rem;">
                        @Model.productDescription
                    </p>
                }
            </div>
        </div>

        <!-- ACTION ROW -->
        <div class="glh-action-row">
            <form asp-action="Delete" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="productsId" />
                <button type="submit" class="glh-btn glh-btn-danger">
                    Yes, Delete Permanently
                </button>
            </form>

            <a asp-controller="producerDashboard"
               asp-action="Index"
               asp-route-activeTab="products"
               class="glh-btn glh-btn-ghost">
                Cancel — Keep Product
            </a>
        </div>

    </div>
</div>