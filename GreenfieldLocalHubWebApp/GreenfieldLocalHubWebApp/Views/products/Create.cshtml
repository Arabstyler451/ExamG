@model GreenfieldLocalHubWebApp.Models.products

@{
    ViewData["Title"] = "Add Product";
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />

<style>
    .glh-create-root {
        --green:       #1B4D3F;
        --green-light: #2a6b58;
        --green-dark:  #122e25;
        --green-faint: #f0f5f3;
        --brown:       #7C5C3E;
        --brown-light: #9b7455;
        --white:       #FFFFFF;
        --off-white:   #F9F9F9;
        --border:      #E2E2E2;
        --border-dark: #C8C8C8;
        --text:        #1A1A1A;
        --text-muted:  #6B6B6B;
        --text-light:  #9A9A9A;
        --font-serif:  'Playfair Display', Georgia, serif;
        --font-sans:   'DM Sans', system-ui, sans-serif;
        --transition:  all .22s ease;
        font-family: var(--font-sans);
        color: var(--text);
    }

    /* ── Page hero ── */
    .glh-hero {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        padding: 2.5rem 0 2rem;
    }
    .glh-hero-inner {
        max-width: 1320px;
        margin: 0 auto;
        padding: 0 2rem;
    }
    .glh-eyebrow {
        font-size: .72rem;
        font-weight: 600;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--brown);
        margin-bottom: .5rem;
        display: block;
    }
    .glh-hero h1 {
        font-family: var(--font-serif);
        font-size: clamp(1.6rem, 3.5vw, 2.4rem);
        font-weight: 600;
        color: var(--green-dark);
        margin: 0;
    }

    /* ── Breadcrumb ── */
    .glh-breadcrumb {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .78rem;
        color: var(--text-light);
        margin-bottom: .75rem;
        flex-wrap: wrap;
    }
    .glh-breadcrumb a { color: var(--text-muted); text-decoration: none; transition: color .2s; }
    .glh-breadcrumb a:hover { color: var(--green); }
    .glh-breadcrumb-sep { color: var(--border-dark); }

    /* ── Section ── */
    .glh-section {
        max-width: 1320px;
        margin: 0 auto;
        padding: 3.5rem 2rem;
    }

    /* ── Grid ── */
    .glh-grid {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 2.5rem;
        align-items: start;
    }

    /* ── Card ── */
    .glh-card {
        background: var(--white);
        border: 1px solid var(--border);
        margin-bottom: 1.5rem;
        overflow: hidden;
    }
    .glh-card-header {
        padding: 1.2rem 1.6rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: .75rem;
    }
    .glh-card-num {
        width: 26px;
        height: 26px;
        background: var(--green);
        color: #fff;
        font-size: .72rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .glh-card-header h2 {
        font-family: var(--font-serif);
        font-size: 1.05rem;
        color: var(--green-dark);
        font-weight: 600;
        margin: 0;
    }
    .glh-card-body { padding: 1.6rem; }

    /* ── Form ── */
    .glh-form-group { margin-bottom: 1.2rem; }
    .glh-form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
    .glh-form-label {
        display: block;
        font-size: .82rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: .4rem;
    }
    .glh-form-hint {
        font-size: .75rem;
        color: var(--text-muted);
        margin-top: .3rem;
        line-height: 1.45;
    }
    .glh-form-input,
    .glh-form-select,
    .glh-form-textarea {
        width: 100%;
        padding: .75rem 1rem;
        border: 1.5px solid var(--border);
        font-family: var(--font-sans);
        font-size: .875rem;
        background: var(--white);
        color: var(--text);
        transition: var(--transition);
        outline: none;
        appearance: none;
        box-sizing: border-box;
    }
    .glh-form-input:focus,
    .glh-form-select:focus,
    .glh-form-textarea:focus {
        border-color: var(--green);
        box-shadow: 0 0 0 3px rgba(27,77,63,.08);
    }
    .glh-form-textarea { min-height: 120px; resize: vertical; }
    .glh-select-wrap { position: relative; }
    .glh-select-wrap::after {
        content: '▾';
        position: absolute;
        right: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        pointer-events: none;
        font-size: .8rem;
    }
    .glh-field-error {
        display: block;
        font-size: .75rem;
        color: #a0281e;
        margin-top: .3rem;
    }
    .glh-alert-error {
        background: #fde8e8;
        border-left: 3px solid #a0281e;
        color: #a0281e;
        padding: .85rem 1.1rem;
        font-size: .83rem;
        margin-bottom: 1.4rem;
    }

    /* ── Availability toggle ── */
    .glh-toggle-wrap {
        display: flex;
        align-items: center;
        gap: .85rem;
        padding: .85rem 1rem;
        border: 1.5px solid var(--border);
        background: var(--off-white);
    }
    .glh-toggle {
        position: relative;
        width: 42px;
        height: 24px;
        flex-shrink: 0;
    }
    .glh-toggle input {
        opacity: 0;
        width: 0;
        height: 0;
        position: absolute;
    }
    .glh-toggle-slider {
        position: absolute;
        inset: 0;
        background: var(--border-dark);
        transition: var(--transition);
        cursor: pointer;
    }
    .glh-toggle-slider::before {
        content: '';
        position: absolute;
        width: 18px;
        height: 18px;
        left: 3px;
        top: 3px;
        background: white;
        transition: var(--transition);
    }
    .glh-toggle input:checked + .glh-toggle-slider { background: var(--green); }
    .glh-toggle input:checked + .glh-toggle-slider::before { transform: translateX(18px); }
    .glh-toggle-label { font-size: .875rem; color: var(--text); font-weight: 500; }
    .glh-toggle-sub { font-size: .75rem; color: var(--text-muted); margin-top: .15rem; }

    /* ── Progress steps ── */
    .glh-progress {
        display: flex;
        align-items: center;
        gap: 0;
        margin-bottom: 2rem;
    }
    .glh-progress-step {
        display: flex;
        align-items: center;
        gap: .5rem;
        font-size: .78rem;
        font-weight: 600;
        color: var(--text-light);
    }
    .glh-progress-step.active { color: var(--green); }
    .glh-progress-dot {
        width: 22px;
        height: 22px;
        border: 2px solid var(--border);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .65rem;
        font-weight: 700;
        flex-shrink: 0;
        background: var(--white);
    }
    .glh-progress-step.active .glh-progress-dot {
        background: var(--green);
        border-color: var(--green);
        color: #fff;
    }
    .glh-progress-line {
        flex: 1;
        height: 1px;
        background: var(--border);
        margin: 0 .75rem;
    }

    /* ── Sidebar ── */
    .glh-sidebar-card {
        background: var(--white);
        border: 1px solid var(--border);
        padding: 1.8rem;
        position: sticky;
        top: 90px;
    }
    .glh-sidebar-title {
        font-family: var(--font-serif);
        font-size: 1.2rem;
        color: var(--green-dark);
        margin-bottom: 1.2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border);
    }

    /* ── Checklist ── */
    .glh-checklist { list-style: none; padding: 0; margin: 0 0 1.5rem; }
    .glh-checklist li {
        display: flex;
        align-items: center;
        gap: .6rem;
        font-size: .82rem;
        color: var(--text-muted);
        padding: .45rem 0;
        border-bottom: 1px solid var(--border);
    }
    .glh-checklist li:last-child { border-bottom: none; }
    .glh-checklist-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--border-dark);
        flex-shrink: 0;
        transition: var(--transition);
    }
    .glh-checklist li.done .glh-checklist-dot { background: var(--green); }
    .glh-checklist li.done { color: var(--text); }

    /* ── Buttons ── */
    .glh-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        padding: .8rem 1.75rem;
        font-size: .875rem;
        font-weight: 600;
        border: none;
        transition: var(--transition);
        cursor: pointer;
        letter-spacing: .02em;
        font-family: var(--font-sans);
        text-decoration: none;
        width: 100%;
        margin-bottom: .65rem;
    }
    .glh-btn-primary { background: var(--green); color: #fff; }
    .glh-btn-primary:hover { background: var(--green-light); color: #fff; }
    .glh-btn-ghost {
        background: transparent;
        color: var(--text);
        border: 1.5px solid var(--border);
    }
    .glh-btn-ghost:hover { border-color: var(--green); color: var(--green); }

    /* ── Info box ── */
    .glh-info-box {
        background: var(--green-faint);
        border: 1px solid rgba(27,77,63,.15);
        padding: 1rem 1.2rem;
        font-size: .82rem;
        line-height: 1.65;
        color: var(--text-muted);
        margin-top: 1rem;
    }
    .glh-info-box strong {
        display: block;
        color: var(--green-dark);
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: .3rem;
    }

    /* ── Image preview ── */
    .glh-img-preview {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border: 1px solid var(--border);
        display: none;
        margin-top: .75rem;
    }
    .glh-img-placeholder {
        width: 100%;
        aspect-ratio: 1;
        background: var(--off-white);
        border: 1.5px dashed var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: .5rem;
        color: var(--text-light);
        font-size: .78rem;
        margin-top: .75rem;
    }

    @@media (max-width: 900px) {
        .glh-grid { grid-template-columns: 1fr; }
        .glh-sidebar-card { position: static; }
    }
    @@media (max-width: 540px) {
        .glh-section { padding: 2rem 1rem; }
        .glh-form-row { grid-template-columns: 1fr; }
        .glh-card-body { padding: 1.2rem; }
    }
</style>

<div class="glh-create-root">

    <!-- PAGE HERO -->
    <div class="glh-hero">
        <div class="glh-hero-inner">
            <nav class="glh-breadcrumb" aria-label="Breadcrumb">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <span class="glh-breadcrumb-sep">›</span>
                <a asp-controller="producerDashboard" asp-action="Index">Dashboard</a>
                <span class="glh-breadcrumb-sep">›</span>
                <span aria-current="page">Add Product</span>
            </nav>
            <span class="glh-eyebrow">Product Management</span>
            <h1>Add New Product</h1>
        </div>
    </div>

    <div class="glh-section">

        <!-- PROGRESS STEPS -->
        <div class="glh-progress" aria-label="Form progress">
            <div class="glh-progress-step active">
                <span class="glh-progress-dot">1</span>
                Details
            </div>
            <div class="glh-progress-line"></div>
            <div class="glh-progress-step active">
                <span class="glh-progress-dot">2</span>
                Stock
            </div>
            <div class="glh-progress-line"></div>
            <div class="glh-progress-step active">
                <span class="glh-progress-dot">3</span>
                Image
            </div>
        </div>

        <form asp-action="Create" method="post" id="createForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="glh-alert-error"></div>

            <div class="glh-grid">

                <!-- LEFT COLUMN -->
                <div>

                    <!-- Card 1: Core Details -->
                    <div class="glh-card">
                        <div class="glh-card-header">
                            <span class="glh-card-num">1</span>
                            <h2>Product Details</h2>
                        </div>
                        <div class="glh-card-body">

                            <div class="glh-form-group">
                                <label asp-for="productName" class="glh-form-label">Product Name</label>
                                <input asp-for="productName" class="glh-form-input"
                                       placeholder="e.g. Organic Free Range Eggs"
                                       oninput="updateChecklist()" />
                                <span asp-validation-for="productName" class="glh-field-error"></span>
                            </div>

                            <div class="glh-form-group">
                                <label asp-for="productDescription" class="glh-form-label">Description</label>
                                <textarea asp-for="productDescription" class="glh-form-textarea"
                                          placeholder="Describe your product — origin, quality, taste, certifications…"
                                          oninput="updateChecklist()"></textarea>
                                <span asp-validation-for="productDescription" class="glh-field-error"></span>
                            </div>

                            <div class="glh-form-row">
                                <div class="glh-form-group">
                                    <label asp-for="productPrice" class="glh-form-label">Price (£)</label>
                                    <input asp-for="productPrice" type="number" step="0.01" min="0"
                                           class="glh-form-input" placeholder="0.00"
                                           oninput="updateChecklist()" />
                                    <span asp-validation-for="productPrice" class="glh-field-error"></span>
                                </div>
                                <div class="glh-form-group">
                                    <label asp-for="productUnit" class="glh-form-label">Unit</label>
                                    <input asp-for="productUnit" class="glh-form-input"
                                           placeholder="e.g. kg, litre, each" />
                                    <span asp-validation-for="productUnit" class="glh-field-error"></span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Card 2: Stock & Category -->
                    <div class="glh-card">
                        <div class="glh-card-header">
                            <span class="glh-card-num">2</span>
                            <h2>Stock &amp; Category</h2>
                        </div>
                        <div class="glh-card-body">

                            <div class="glh-form-row">
                                <div class="glh-form-group">
                                    <label asp-for="stockQuantity" class="glh-form-label">Stock Quantity</label>
                                    <input asp-for="stockQuantity" type="number" min="0"
                                           class="glh-form-input" placeholder="0"
                                           oninput="updateChecklist()" />
                                    <span asp-validation-for="stockQuantity" class="glh-field-error"></span>
                                </div>
                                <div class="glh-form-group">
                                    <label asp-for="categoriesId" class="glh-form-label">Category</label>
                                    <div class="glh-select-wrap">
                                        <select asp-for="categoriesId"
                                                asp-items="ViewBag.categoriesId"
                                                class="glh-form-select"
                                                onchange="updateChecklist()">
                                            <option value="">— Select category —</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="categoriesId" class="glh-field-error"></span>
                                </div>
                            </div>

                            <div class="glh-form-group">
                                <label class="glh-form-label">Availability</label>
                                <div class="glh-toggle-wrap">
                                    <label class="glh-toggle">
                                        <input asp-for="productAvailability" type="checkbox" checked />
                                        <span class="glh-toggle-slider"></span>
                                    </label>
                                    <div>
                                        <div class="glh-toggle-label">Available for purchase</div>
                                        <div class="glh-toggle-sub">Toggle off to save as draft</div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- Card 3: Image -->
                    <div class="glh-card">
                        <div class="glh-card-header">
                            <span class="glh-card-num">3</span>
                            <h2>Product Image</h2>
                        </div>
                        <div class="glh-card-body">
                            <div class="glh-form-group">
                                <label asp-for="productImage" class="glh-form-label">Image URL</label>
                                <input asp-for="productImage" class="glh-form-input"
                                       placeholder="https://example.com/image.jpg"
                                       oninput="previewImage(this.value); updateChecklist()" />
                                <p class="glh-form-hint">Paste a direct link to your product image. Supported: JPG, PNG, WebP.</p>
                                <span asp-validation-for="productImage" class="glh-field-error"></span>
                            </div>
                            <img id="imgPreview" class="glh-img-preview" alt="Preview"
                                 onerror="this.style.display='none'" />
                            <div id="imgPlaceholder" class="glh-img-placeholder">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                                    <circle cx="8.5" cy="8.5" r="1.5"/>
                                    <polyline points="21 15 16 10 5 21"/>
                                </svg>
                                <span>Image preview</span>
                            </div>
                        </div>
                    </div>


                    @if (User.IsInRole("Admin") || User.IsInRole("Developer"))
{
    <div class="glh-card">
        <div class="glh-card-header">
            <span class="glh-card-num">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </span>
            <h2>Assign Producer</h2>
        </div>
        <div class="glh-card-body">
            <div class="glh-form-group">
                <label asp-for="producersId" class="glh-form-label">Producer</label>
                <div class="glh-select-wrap">
                    <select asp-for="producersId"
                            asp-items="ViewBag.producersId"
                            class="glh-form-select">
                        <option value="">— Select producer —</option>
                    </select>
                </div>
                <span asp-validation-for="producersId" class="glh-field-error"></span>
            </div>
        </div>
    </div>
}

                </div>

                <!-- RIGHT COLUMN: SIDEBAR -->
                <aside>
                    <div class="glh-sidebar-card">
                        <h2 class="glh-sidebar-title">Before You Publish</h2>

                        <ul class="glh-checklist" id="checklist">
                            <li id="chk-name">
                                <span class="glh-checklist-dot"></span>
                                Product name entered
                            </li>
                            <li id="chk-desc">
                                <span class="glh-checklist-dot"></span>
                                Description added
                            </li>
                            <li id="chk-price">
                                <span class="glh-checklist-dot"></span>
                                Price set
                            </li>
                            <li id="chk-stock">
                                <span class="glh-checklist-dot"></span>
                                Stock quantity entered
                            </li>
                            <li id="chk-cat">
                                <span class="glh-checklist-dot"></span>
                                Category selected
                            </li>
                            <li id="chk-img">
                                <span class="glh-checklist-dot"></span>
                                Image URL provided
                            </li>
                        </ul>

                        <button type="submit" class="glh-btn glh-btn-primary">
                            Publish Product
                        </button>
                        <a asp-controller="producerDashboard" asp-action="Index"
                           asp-route-activeTab="products"
                           class="glh-btn glh-btn-ghost">
                            Cancel
                        </a>

                        <div class="glh-info-box">
                            <strong>Tip</strong>
                            Products go live immediately once published. You can edit or hide them at any time from your dashboard.
                        </div>
                    </div>
                </aside>

            </div>
        </form>
    </div>
</div>

<script>
    function previewImage(url) {
        const img         = document.getElementById('imgPreview');
        const placeholder = document.getElementById('imgPlaceholder');
        if (url) {
            img.src             = url;
            img.style.display   = 'block';
            placeholder.style.display = 'none';
        } else {
            img.style.display         = 'none';
            placeholder.style.display = 'flex';
        }
    }

    function updateChecklist() {
        const val = (id) => document.querySelector(`[name="${id}"]`)?.value?.trim();
        const sel = (id) => document.querySelector(`[name="${id}"]`)?.value;

        const checks = {
            'chk-name':  !!val('productName'),
            'chk-desc':  !!val('productDescription'),
            'chk-price': !!val('productPrice') && parseFloat(val('productPrice')) > 0,
            'chk-stock': !!val('stockQuantity'),
            'chk-cat':   !!sel('categoriesId'),
            'chk-img':   !!val('productImage'),
        };

        Object.entries(checks).forEach(([id, done]) => {
            document.getElementById(id)?.classList.toggle('done', done);
        });
    }

    // Run on load in case of validation postback
    updateChecklist();
</script>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}