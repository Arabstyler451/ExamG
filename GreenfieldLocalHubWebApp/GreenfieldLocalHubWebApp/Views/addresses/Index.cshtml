@model IEnumerable<GreenfieldLocalHubWebApp.Models.address>
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "My Addresses";
}

<style>
    /* ── SHARED TOKENS ── */
    :root {
        --green: #1B4D3F;
        --green-light: #2a6b58;
        --green-dark: #122e25;
        --green-faint: #f0f5f3;
        --brown: #7C5C3E;
        --brown-light: #9b7455;
        --white: #FFFFFF;
        --off-white: #F9F9F9;
        --border: #E2E2E2;
        --border-dark: #C8C8C8;
        --text: #1A1A1A;
        --text-muted: #6B6B6B;
        --text-light: #9A9A9A;
        --shadow-sm: 0 2px 8px rgba(0,0,0,.08);
        --shadow-md: 0 6px 20px rgba(0,0,0,.10);
        --font-serif: 'Playfair Display', Georgia, serif;
        --font-sans: 'DM Sans', system-ui, sans-serif;
        --transition: all .22s ease;
    }

    .container {
    max-width: 100%;
    padding: 0 2rem;
}

    /* ── PAGE HERO ── */
    .page-hero {
        background: var(--white);
        padding: 0rem 2rem 2.5rem;
    }
    .page-hero-inner { max-width: 1320px; margin: 0 auto; }
    .page-eyebrow {
        font-size: .72rem; font-weight: 600; letter-spacing: .12em;
        text-transform: uppercase; color: var(--brown); margin-bottom: .5rem;
        display: block;
    }
    .page-hero h1 {
        font-family: var(--font-serif);
        font-size: clamp(1.6rem, 3.5vw, 2.4rem);
        font-weight: 600; color: var(--green-dark);
    }
    .page-hero p {
        color: var(--text-muted); font-size: .95rem;
        margin-top: .5rem; max-width: 540px; line-height: 1.65;
    }

    /* ── ACCOUNT LAYOUT ── */
    .account-layout {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 2rem;
    }


    /* ── PANEL ── */
    .panel-title {
        font-family: var(--font-serif);
        font-size: 1.5rem; color: var(--green-dark);
        margin-bottom: 1.4rem;
    }

    /* ── ADDRESS GRID ── */
.address-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(460px, 520px));
    gap: 1.5rem;
}

    /* Address Card - Exact match from index.html */
    .address-card {
    background: var(--white);
    border: 1px solid var(--border);
    padding: 1.5rem;
    position: relative;
    transition: var(--transition);
}
    .address-card:hover {
        border-color: var(--green);
        box-shadow: var(--shadow-md);
    }
    .address-card.is-default {
        border: 2px solid var(--green);
    }
    .address-card-badge {
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--green);
        margin-bottom: .7rem;
        display: block;
    }
    .address-card-lines {
        font-size: .9rem;
        line-height: 1.7;
        color: var(--text);
        margin-bottom: 1rem;
    }
    .address-card-actions {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
    }

    /* Add New Address Card - Exact match */
    .address-card-new {
    background: var(--off-white);
    border: 1.5px dashed var(--border);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    min-height: 180px;
    transition: var(--transition);
    text-decoration: none;

}
    .address-card-new:hover {
        border-color: var(--green);
        background: var(--green-faint);
    }
    .address-card-new-icon {
        font-size: 1.6rem;
        color: var(--text-light);
        margin-bottom: .4rem;
        line-height: 1;
    }
    .address-card-new-label {
        font-size: .85rem;
        color: var(--text-muted);
    }

    /* Buttons */
    .btn {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .75rem 1.75rem; font-size: .875rem; font-weight: 600;
        border: none; transition: var(--transition); cursor: pointer;
        letter-spacing: .02em; font-family: var(--font-sans);
        text-decoration: none;
    }
    .btn-primary { background: var(--green); color: var(--white); }
    .btn-primary:hover { background: var(--green-light); }
    .btn-ghost {
        background: transparent; color: var(--text);
        border: 1.5px solid var(--border);
    }
    .btn-ghost:hover { border-color: var(--green); color: var(--green); }
    .btn-danger {
        background: transparent; color: #a0281e;
        border: 1.5px solid #f5c6c4;
    }
    .btn-danger:hover { background: #a0281e; border-color: #a0281e; }
    .btn-sm { padding: .45rem 1rem; font-size: .78rem; }

    /* Alerts */
    .alert {
        padding: .9rem 1.2rem; font-size: .85rem;
        margin-bottom: 1.4rem;
        display: flex; align-items: flex-start; gap: .6rem;
        border-left: 3px solid;
    }
    .alert-success { background: #eaf4ef; color: #1a6b40; border-color: #1a6b40; }
    .alert-info { background: #e8eef8; color: #1a3a8f; border-color: #1a3a8f; }

    /* Empty State */
.empty-state {
    text-align: center;
    padding: 3.5rem 2rem;
    border: 1px solid var(--border);
    background: var(--white);
    flex: 1 1 880px;    /* Match your card flex behavior */
    min-width: 955px;    /* Match your card min-width */
    max-width: 1000px;    /* Match your card max-width */
}
    .empty-state-icon {
        width: 52px; height: 52px;
        background: var(--green-faint);
        border: 1px solid rgba(27,77,63,.12);
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1.2rem;
    }
    .empty-state-icon svg {
        width: 24px; height: 24px;
        stroke: var(--green); fill: none; stroke-width: 2; stroke-linecap: round;
    }
    .empty-state h3 {
        font-family: var(--font-serif);
        font-size: 1.15rem; color: var(--green-dark);
        margin-bottom: .5rem;
    }
    .empty-state p {
        font-size: .875rem; color: var(--text-muted);
        margin-bottom: 1.4rem;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .account-layout { grid-template-columns: 1fr; }
    }
@@media (max-width: 540px) {
    .address-card, .address-card-new {
        flex: 1 1 100%;
        min-width: auto;
        max-width: none;
    }
}
</style>

<!-- PAGE HERO -->
<div class="page-hero">
    <div class="page-hero-inner">
        <h1>Address Book</h1>
        <p>Manage your saved delivery addresses.</p>
    </div>
</div>

<!-- MAIN CONTENT -->
<section class="section">
    <div class="container">
        <div class="account-layout">


            <!-- ADDRESS PANEL -->
            <div>
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" role="status">
                        @TempData["SuccessMessage"]
                    </div>
                }
                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info" role="status">
                        @TempData["InfoMessage"]
                    </div>
                }

                @if (!Model.Any())
                {
                    <!-- EMPTY STATE -->
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                                <circle cx="12" cy="10" r="3"/>
                            </svg>
                        </div>
                        <h3>No addresses saved yet</h3>
                        <p>Add a delivery address to speed up your checkout.</p>
                        <a asp-controller="addresses" asp-action="Create" class="btn btn-primary">
                            Add Your First Address
                        </a>
                    </div>
                }
                else
                {
                    <div class="address-grid">
    @foreach (var addr in Model)
    {
        <div class="address-card @(addr.IsDefault ? "is-default" : "")">
            @if (addr.IsDefault)
            {
                <span class="address-card-badge">Default Address</span>
            }
            <p class="address-card-lines">
                @addr.street<br>
                @addr.city<br>
                @addr.postalCode<br>
                @addr.country
            </p>
            <div class="address-card-actions">
                <a asp-controller="addresses"
                   asp-action="Edit"
                   asp-route-id="@addr.addressId"
                   class="btn btn-ghost btn-sm">
                    Edit
                </a>
                @if (!addr.IsDefault)
                {
                    <form asp-controller="addresses"
                          asp-action="SetDefault"
                          asp-route-id="@addr.addressId"
                          method="post"
                          style="display: inline;">
                        <button type="submit" class="btn btn-ghost btn-sm">
                            Set as Default
                        </button>
                    </form>
                }
                <form asp-controller="addresses"
                   asp-action="Delete"
                   asp-route-id="@addr.addressId"
                   method="post"
                   style="display: inline;">
                   <input type="hidden" name="addressId" value="@addr.addressId" />
                    <button type="submit" class="btn btn-danger btn-sm" aria-label="Remove @addr.addressId from address book">
                        Remove
                    </button>
                </form>
            </div>
        </div>
    }

    <!-- ADD NEW ADDRESS CARD -->
    <a asp-controller="addresses" asp-action="Create" class="address-card-new">
        <div class="address-card-new-icon">+</div>
        <p class="address-card-new-label">Add new address</p>
    </a>
</div>
                }
            </div>
        </div>
    </div>
</section>