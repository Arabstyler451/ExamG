@model GreenfieldLocalHubWebApp.Models.producers

@{
    ViewData["Title"] = "Producer Details";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">

<style>
    :root {
        --green:       #1B4D3F;
        --green-light: #2a6b58;
        --green-dark:  #122e25;
        --brown:       #7C5C3E;
        --white:       #FFFFFF;
        --off-white:   #F9F9F9;
        --border:      #E2E2E2;
        --text:        #1A1A1A;
        --text-muted:  #6B6B6B;
        --font-serif:  'Playfair Display', Georgia, serif;
        --font-sans:   'DM Sans', system-ui, sans-serif;
        --transition:  all .22s ease;
    }

    .pd-page-hero {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        padding: 3rem 2rem 2.5rem;
    }
    .pd-page-hero-inner { max-width: 1320px; margin: 0 auto; }

    .pd-breadcrumb {
        display: flex; align-items: center; gap: .5rem;
        font-size: .78rem; color: #9A9A9A;
        font-family: var(--font-sans); list-style: none; padding: 0; margin: 0;
    }
    .pd-breadcrumb a { color: var(--text-muted); text-decoration: none; transition: color .2s; }
    .pd-breadcrumb a:hover { color: var(--green); }
    .pd-breadcrumb-sep { color: #C8C8C8; }

    .pd-section { padding: 5rem 2rem; }
    .pd-container { max-width: 1320px; margin: 0 auto; }

    .pd-hero-image {
        width: 100%; aspect-ratio: 21/9;
        background: #E8E8E8;
        display: flex; align-items: center; justify-content: center;
        color: #999; font-size: .8rem; font-weight: 500;
        letter-spacing: .06em; text-transform: uppercase;
        margin-bottom: 3rem; overflow: hidden;
    }
    .pd-hero-image img { width: 100%; height: 100%; object-fit: cover; }

    .pd-layout {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 3rem;
        align-items: start;
    }

    .pd-sidebar {
        background: var(--white);
        border: 1px solid var(--border);
        padding: 2rem;
    }
    .pd-producer-name {
        font-family: var(--font-serif);
        font-size: 1.5rem;
        color: var(--green-dark);
        margin-bottom: .3rem;
    }
    .pd-producer-type {
        font-size: .72rem; font-weight: 700;
        text-transform: uppercase; letter-spacing: .09em;
        color: var(--brown); margin-bottom: 1.2rem;
        font-family: var(--font-sans);
    }
    .pd-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1.4rem; }
    .pd-tag {
        background: var(--off-white); color: var(--text-muted);
        font-size: .7rem; padding: .2rem .65rem;
        border: 1px solid var(--border); font-weight: 500;
        font-family: var(--font-sans);
    }
    .pd-contact-info {
        font-size: .83rem; color: var(--text-muted); line-height: 1.8;
        border-top: 1px solid var(--border); padding-top: 1.2rem;
        font-family: var(--font-sans);
    }
    .pd-btn-primary {
        display: inline-flex; align-items: center; justify-content: center;
        width: 100%; margin-top: 1.4rem;
        padding: .75rem 1.75rem; font-size: .875rem; font-weight: 600;
        background: var(--green); color: var(--white);
        border: none; cursor: pointer; letter-spacing: .02em;
        font-family: var(--font-sans); transition: var(--transition);
        text-decoration: none;
    }
    .pd-btn-primary:hover { background: var(--green-light); color: var(--white); }

    .pd-eyebrow {
        display: inline-block; font-size: .72rem; font-weight: 600;
        letter-spacing: .14em; text-transform: uppercase; color: var(--brown);
        margin-bottom: .75rem; font-family: var(--font-sans);
    }
    .pd-story-title {
        font-family: var(--font-serif);
        font-size: 1.6rem; color: var(--green-dark); margin-bottom: 1rem;
    }
    .pd-story-text {
        color: var(--text-muted); line-height: 1.8;
        font-size: .93rem; margin-bottom: .9rem;
        font-family: var(--font-sans);
    }

    .pd-stats {
        display: grid; grid-template-columns: repeat(3, 1fr);
        gap: 1px; background: var(--border); margin-bottom: 2rem;
    }
    .pd-stat { background: var(--white); padding: 1.2rem; text-align: center; }
    .pd-stat strong {
        display: block; font-family: var(--font-serif);
        font-size: 1.6rem; color: var(--green);
    }
    .pd-stat p {
        font-size: .75rem; color: var(--text-muted);
        margin-top: .3rem; text-transform: uppercase; letter-spacing: .06em;
        font-family: var(--font-sans);
    }

    /* ── Products grid ── */
    .pd-products-title {
        font-family: var(--font-serif);
        font-size: 1.2rem; color: var(--green-dark); margin-bottom: 1.2rem;
    }
    .pd-product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
        gap: 1.5rem;
    }
    .pd-product-card {
        background: var(--white); border: 1px solid var(--border);
        transition: var(--transition); text-decoration: none; color: inherit;
        display: block; overflow: hidden;
    }
    .pd-product-card:hover { border-color: var(--green); box-shadow: 0 6px 20px rgba(0,0,0,.10); }
    .pd-product-card:hover .pd-pc-img-inner { transform: scale(1.03); }
    .pd-pc-img { overflow: hidden; }
    .pd-pc-img-inner {
        width: 100%; aspect-ratio: 1;
        transition: transform .4s ease;
        background: #E8E8E8;
        display: flex; align-items: center; justify-content: center;
        overflow: hidden;
    }
    .pd-pc-img-inner img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pd-pc-img-placeholder {
        color: #999; font-size: .75rem; font-weight: 500;
        letter-spacing: .08em; text-transform: uppercase;
        font-family: var(--font-sans);
    }
    .pd-pc-body { padding: 1.1rem 1.2rem 1.3rem; }
    .pd-pc-producer {
        font-size: .68rem; font-weight: 600; text-transform: uppercase;
        letter-spacing: .08em; color: var(--brown); margin-bottom: .3rem;
        font-family: var(--font-sans);
    }
    .pd-pc-name {
        font-weight: 600; font-size: .95rem; margin-bottom: .3rem;
        color: var(--text); line-height: 1.3; font-family: var(--font-sans);
    }
    .pd-pc-footer {
        display: flex; align-items: center; justify-content: space-between;
        margin-top: .9rem;
    }
    .pd-pc-price {
        font-family: var(--font-serif); font-size: 1.1rem;
        font-weight: 600; color: var(--green);
    }
    .pd-avail {
        font-size: .68rem; font-weight: 600; padding: .2rem .55rem;
        letter-spacing: .04em; font-family: var(--font-sans);
    }
    .pd-avail.in  { background: #eaf4ef; color: #1a6b40; }
    .pd-avail.out { background: #fde8e8; color: #a0281e; }

    .pd-no-products {
        font-size: .88rem; color: var(--text-muted);
        font-family: var(--font-sans);
    }

    .pd-back-link {
        display: inline-flex; align-items: center; gap: .4rem;
        font-size: .875rem; font-weight: 600; color: var(--text);
        border: 1.5px solid var(--border); padding: .75rem 1.75rem;
        text-decoration: none; font-family: var(--font-sans);
        transition: var(--transition); margin-top: 2rem;
    }
    .pd-back-link:hover { border-color: var(--green); color: var(--green); }
</style>

<!-- Breadcrumb hero -->
<div class="pd-page-hero">
    <div class="pd-page-hero-inner">
        <nav class="pd-breadcrumb" aria-label="Breadcrumb">
            <a asp-action="Index" asp-controller="Home">Home</a>
            <span class="pd-breadcrumb-sep">›</span>
            <a asp-action="Index">Producers</a>
            <span class="pd-breadcrumb-sep">›</span>
            <span aria-current="page">@Model?.producerName</span>
        </nav>
    </div>
</div>

<section class="pd-section">
    <div class="pd-container">

        <!-- Full-width hero image -->
        <div class="pd-hero-image">
            @if (!string.IsNullOrWhiteSpace(Model?.producerImage))
            {
                <img src="@Model.producerImage" alt="@Model.producerName" />
            }
            else
            {
                <span>Image</span>
            }
        </div>

        <!-- Sidebar + main body -->
        <div class="pd-layout">

            <!-- LEFT: info card -->
            <div class="pd-sidebar">
                <h1 class="pd-producer-name">@Model?.producerName</h1>
                <p class="pd-producer-type">@Model?.producerLocation</p>

                <div class="pd-tags">
                    <span class="pd-tag">Local Producer</span>
                    <span class="pd-tag">Traceable</span>
                </div>

                <div class="pd-contact-info">
                    <p>Location: @Model?.producerLocation</p>
                    <p>Email: @Model?.producerEmail</p>
                    <p>Tel: @Model?.producerPhone</p>
                </div>

                <a class="pd-btn-primary" href="/Home/Contact">Contact Us</a>
            </div>

            <!-- RIGHT: story + stats + products -->
            <div>
                <span class="pd-eyebrow">Our Story</span>
                <h2 class="pd-story-title">About @Model?.producerName</h2>
                <p class="pd-story-text">@Model?.producerDescription</p>

                <div class="pd-stats">
                    <div class="pd-stat">
                        <strong>Local</strong>
                        <p>Producer</p>
                    </div>
                    <div class="pd-stat">
                        <strong>100%</strong>
                        <p>Traceable</p>
                    </div>
                    <div class="pd-stat">
                        <strong>GLH</strong>
                        <p>Verified</p>
                    </div>
                </div>

                <!-- Products from this producer -->
                <h3 class="pd-products-title">Products from @Model?.producerName</h3>

                @if (Model?.products != null && Model.products.Any())
                {
                    <div class="pd-product-grid">
                        @foreach (var product in Model.products)
                        {
                            string availClass = product.productAvailability ? "in" : "out";
                            string availLabel = product.productAvailability ? "In Stock" : "Out of Stock";

                            <a class="pd-product-card"
                               asp-action="Details"
                               asp-controller="products"
                               asp-route-id="@product.productsId"
                               aria-label="View @product.productName">
                                <div class="pd-pc-img">
                                    <div class="pd-pc-img-inner">
                                        @if (!string.IsNullOrWhiteSpace(product.productImage))
                                        {
                                            <img src="@product.productImage"
                                                 alt="@product.productName"
                                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                            <span class="pd-pc-img-placeholder" style="display:none;">Image</span>
                                        }
                                        else
                                        {
                                            <span class="pd-pc-img-placeholder">Image</span>
                                        }
                                    </div>
                                </div>
                                <div class="pd-pc-body">
                                    <h3 class="pd-pc-name">@product.productName</h3>
                                    <div class="pd-pc-footer">
                                        <span class="pd-pc-price">@product.productPrice.ToString("C")</span>
                                        <span class="pd-avail @availClass">@availLabel</span>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="pd-no-products">No products currently listed for this producer.</p>
                }
            </div>

        </div>

        <a asp-action="Index" class="pd-back-link">&#8592; Back to Producers</a>

    </div>
</section>