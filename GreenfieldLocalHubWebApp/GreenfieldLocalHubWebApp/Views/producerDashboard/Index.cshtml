@model IEnumerable<GreenfieldLocalHubWebApp.Models.products>

@{
    ViewData["Title"] = "Producer Dashboard";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">

<style>
    :root {
        --green:       #1B4D3F;
        --green-light: #2a6b58;
        --green-dark:  #122e25;
        --green-faint: #f0f5f3;
        --brown:       #7C5C3E;
        --brown-light: #9b7455;
        --white:       #FFFFFF;
        --off-white:   #F9F9F9;
        --border:      #E2E2E2;
        --text:        #1A1A1A;
        --text-muted:  #6B6B6B;
        --text-light:  #9A9A9A;
        --shadow-sm:   0 2px 8px rgba(0,0,0,.08);
        --shadow-md:   0 6px 20px rgba(0,0,0,.10);
        --font-serif:  'Playfair Display', Georgia, serif;
        --font-sans:   'DM Sans', system-ui, sans-serif;
        --transition:  all .22s ease;
    }

    /* ── PAGE HERO ── */
    .pd-hero {
        background: var(--green-dark);
        padding: 3rem 2rem 2.5rem;
        margin-bottom: 0;
    }
    .pd-hero-inner {
        max-width: 1320px;
        margin: 0 auto;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
    }
    .pd-hero-eyebrow {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .13em;
        text-transform: uppercase;
        color: rgba(255,255,255,.45);
        display: block;
        margin-bottom: .4rem;
    }
    .pd-hero h1 {
        font-family: var(--font-serif);
        font-size: clamp(1.6rem, 3.5vw, 2.4rem);
        font-weight: 600;
        color: var(--white);
        margin: 0 0 .4rem;
    }
    .pd-hero-sub {
        color: rgba(255,255,255,.55);
        font-size: .9rem;
        margin: 0;
    }
    .pd-hero-actions {
        display: flex;
        gap: .6rem;
        flex-wrap: wrap;
        align-items: center;
    }

    /* ── BUTTONS ── */
    .btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .75rem 1.75rem;
        font-size: .875rem;
        font-weight: 600;
        border: none;
        transition: var(--transition);
        cursor: pointer;
        letter-spacing: .02em;
        font-family: var(--font-sans);
        text-decoration: none;
    }
    .btn-brown   { background: var(--brown); color: var(--white); }
    .btn-brown:hover { background: var(--brown-light); color: var(--white); }
    .btn-ghost-white {
        background: rgba(255,255,255,.08);
        color: rgba(255,255,255,.75);
        border: 1px solid rgba(255,255,255,.15);
    }
    .btn-ghost-white:hover { background: rgba(255,255,255,.15); color: var(--white); }
    .btn-primary { background: var(--green); color: var(--white); }
    .btn-primary:hover { background: var(--green-light); color: var(--white); }
    .btn-outline { background: transparent; color: var(--green); border: 1.5px solid var(--green); }
    .btn-outline:hover { background: var(--green); color: var(--white); }
    .btn-ghost   { background: transparent; color: var(--text); border: 1.5px solid var(--border); }
    .btn-ghost:hover { border-color: var(--green); color: var(--green); }
    .btn-sm { padding: .5rem 1.1rem; font-size: .8rem; }

    /* ── DASHBOARD SECTION ── */
    .pd-section {
        padding: 3rem 2rem;
        font-family: var(--font-sans);
    }
    .pd-container { max-width: 1320px; margin: 0 auto; }

    /* ── STAT GRID ── */
    .dash-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
    }
    .dash-stat {
        background: var(--white);
        border: 1px solid var(--border);
        padding: 1.4rem 1.6rem;
    }
    .dash-stat-label {
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .09em;
        color: var(--text-muted);
        margin-bottom: .5rem;
    }
    .dash-stat-value {
        font-family: var(--font-serif);
        font-size: 2rem;
        font-weight: 600;
        color: var(--green-dark);
        line-height: 1;
    }
    .dash-stat-delta { font-size: .78rem; color: #1a6b40; margin-top: .4rem; }
    .dash-stat-delta.warn { color: var(--brown); }

    /* ── TAB BAR ── */
    .tab-bar {
        display: flex;
        border-bottom: 2px solid var(--border);
        margin-bottom: 2rem;
    }
    .tab {
        padding: .75rem 1.4rem;
        font-size: .86rem;
        font-weight: 500;
        color: var(--text-muted);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        transition: var(--transition);
        background: none;
        border-top: none;
        border-left: none;
        border-right: none;
        font-family: var(--font-sans);
    }
    .tab:hover { color: var(--green); }
    .tab.active { color: var(--green); border-bottom-color: var(--green); font-weight: 600; }

    /* ── DTAB PANELS ── */
    .dtab { display: none; }
    .dtab.active { display: block; }

    /* ── TOOLBAR ── */
    .dtab-toolbar {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        align-items: center;
    }
    .form-input, .form-select {
        padding: .75rem 1rem;
        border: 1.5px solid var(--border);
        font-family: var(--font-sans);
        font-size: .875rem;
        background: var(--white);
        color: var(--text);
        transition: var(--transition);
        outline: none;
        appearance: none;
    }
    .form-input:focus, .form-select:focus {
        border-color: var(--green);
        box-shadow: 0 0 0 3px rgba(27,77,63,.08);
    }
    .toolbar-meta {
        margin-left: auto;
        font-size: .83rem;
        color: var(--text-muted);
    }

    /* ── DATA TABLE ── */
    .table-wrap {
        background: var(--white);
        border: 1px solid var(--border);
        overflow: hidden;
    }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table th {
        text-align: left;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .09em;
        color: var(--text-muted);
        padding: .75rem 1.1rem;
        background: var(--off-white);
        border-bottom: 1px solid var(--border);
    }
    .data-table td {
        padding: .95rem 1.1rem;
        border-bottom: 1px solid var(--border);
        font-size: .875rem;
        vertical-align: middle;
    }
    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:hover td { background: #fafafa; }

    /* ── STATUS PILLS ── */
    .order-status {
        padding: .25rem .7rem;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        display: inline-block;
    }
    .order-status.delivered  { background: #eaf4ef; color: #1a6b40; }
    .order-status.processing { background: #fdf3e7; color: #9a5a10; }
    .order-status.dispatched { background: #e8eef8; color: #1a3a8f; }
    .order-status.pending    { background: #f5f5f5; color: #555; }
    .order-status.ready    { background: #e8eef8; color: #1a3a8f; }
    .order-status.collected { background: #eaf4ef; color: #1a6b40; }

    .stock-pill {
        display: inline-block;
        padding: .2rem .65rem;
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .stock-pill.in  { background: #eaf4ef; color: #1a6b40; }
    .stock-pill.low { background: #fdf3e7; color: #9a5a10; }
    .stock-pill.out { background: #fde8e8; color: #a0281e; }

    /* ── EMPTY STATE ── */
    .empty-state {
        text-align: center;
        padding: 3rem 2rem;
        color: var(--text-muted);
        font-size: .95rem;
    }

    /* ── VIEW ALL LINK ── */
    .view-all-link {
        display: inline-block;
        margin-top: 1.2rem;
        font-size: .875rem;
        font-weight: 600;
        color: var(--green);
        text-decoration: none;
        letter-spacing: .01em;
        transition: var(--transition);
    }
    .view-all-link:hover { color: var(--green-light); text-decoration: underline; }

    /* ── RESPONSIVE ── */
    @@media (max-width: 1080px) { .dash-grid { grid-template-columns: 1fr 1fr; } }
    @@media (max-width: 640px)  { .dash-grid { grid-template-columns: 1fr 1fr; } }
</style>

<!-- ════════════════════════════════════
     PRODUCER DASHBOARD HERO
════════════════════════════════════ -->
<div class="pd-hero">
    <div class="pd-hero-inner">
        <div>
            <span class="pd-hero-eyebrow">Producer Dashboard &mdash; Restricted Access</span>
            <h1>Producer Dashboard</h1>
            <p class="pd-hero-sub">Manage your products, orders, and producer profile.</p>
        </div>
        <div class="pd-hero-actions">
            <a asp-controller="products" asp-action="Create" class="btn btn-brown">Add Product</a>
                <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                    <button type="submit" class="btn btn-ghost-white">Sign out</button>
                </form>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════
     DASHBOARD BODY
════════════════════════════════════ -->
<div class="pd-section">
    <div class="pd-container">

        <!-- ── STAT CARDS ── -->
        <div class="dash-grid" role="list" aria-label="Dashboard statistics">
            <div class="dash-stat" role="listitem">
                <p class="dash-stat-label">Total Products</p>
                <p class="dash-stat-value">@ViewBag.totalProducts</p>
                <p class="dash-stat-delta">Listed in your store</p>
            </div>
            <div class="dash-stat" role="listitem">
                <p class="dash-stat-label">Low Stock Products</p>
                <p class="dash-stat-value">@ViewBag.lowStockProducts</p>
                <p class="dash-stat-delta warn">@ViewBag.lowStockProducts low stock alerts</p>
            </div>
            <div class="dash-stat" role="listitem">
                <p class="dash-stat-label">Total Stock Units</p>
                <p class="dash-stat-value">@ViewBag.totalStockUnits</p>
                <p class="dash-stat-delta">Across all products</p>
            </div>
            <div class="dash-stat" role="listitem">
                <p class="dash-stat-label">Recent Orders</p>
                <p class="dash-stat-value">
                    @((ViewBag.recentOrders as List<GreenfieldLocalHubWebApp.Models.orders> ?? new List<GreenfieldLocalHubWebApp.Models.orders>()).Count)
                </p>
                <p class="dash-stat-delta">In the last period</p>
            </div>
        </div>

        <!-- ── TAB BAR ── -->
<div class="tab-bar" role="tablist" aria-label="Dashboard sections">
    <button class="tab @(ViewBag.activeTab == "products" ? "active" : "")"
            role="tab"
            aria-selected="@(ViewBag.activeTab == "products" ? "true" : "false")"
            onclick="switchDashTab(this,'dtab-products')">Product Management</button>
    <button class="tab @(ViewBag.activeTab == "orders" ? "active" : "")"
            role="tab"
            aria-selected="@(ViewBag.activeTab == "orders" ? "true" : "false")"
            onclick="switchDashTab(this,'dtab-orders')">Order Management</button>
</div>

        <!-- ════════════════
             PRODUCTS TAB
        ════════════════ -->
<div id="dtab-products" class="dtab @(ViewBag.activeTab == "products" ? "active" : "")">
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <p>You do not have any products yet.</p>
                    <a asp-controller="products" asp-action="Create" class="btn btn-primary" style="margin-top:1.2rem;">Add Your First Product</a>
                </div>
            }
            else
            {
                <div class="dtab-toolbar">
                    <input type="search" class="form-input" placeholder="Search your products…"
                           style="max-width:240px;" aria-label="Search products"
                           oninput="filterTable(this,'products-tbody')">
                    <a asp-controller="products" asp-action="Create" class="btn btn-primary btn-sm">Add Product</a>
                </div>

<div class="table-wrap">
    <table class="data-table" role="table" aria-label="Product management table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="products-tbody">
            @foreach (var item in Model.Take(5))
            {
                var stockClass = item.stockQuantity == 0 ? "out"
                               : item.stockQuantity <= 10 ? "low"
                               : "in";
                var stockLabel = item.stockQuantity == 0 ? "Out of Stock"
                               : item.stockQuantity <= 10 ? "Low Stock"
                               : "In Stock";
                <tr>
                    <td>
                        <div style="display:flex; align-items:center; gap:.85rem;">
                            @if (!string.IsNullOrEmpty(item.productImage))
                            {
                                <img src="@item.productImage"
                                     alt="@item.productName"
                                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                                     style="width:48px;height:48px;object-fit:cover;
                                            border:1px solid var(--border);flex-shrink:0;" />
                                <div style="width:48px;height:48px;background:var(--off-white);
                                            border:1px solid var(--border);display:none;
                                            align-items:center;justify-content:center;
                                            font-size:.55rem;color:var(--text-light);
                                            text-transform:uppercase;letter-spacing:.04em;
                                            flex-shrink:0;">
                                    IMG
                                </div>
                            }
                            else
                            {
                                <div style="width:48px;height:48px;background:var(--off-white);
                                            border:1px solid var(--border);display:flex;
                                            align-items:center;justify-content:center;
                                            font-size:.55rem;color:var(--text-light);
                                            text-transform:uppercase;letter-spacing:.04em;
                                            flex-shrink:0;">
                                    IMG
                                </div>
                            }
                            <strong>@item.productName</strong>
                        </div>
                    </td>
                    <td>£@item.productPrice.ToString("0.00")</td>
                    <td>@item.stockQuantity units</td>
                    <td><span class="stock-pill @stockClass">@stockLabel</span></td>
                    <td>
                        <div style="display:flex;gap:.5rem;align-items:center;">
                            <a asp-controller="products" asp-action="Edit"
                               asp-route-id="@item.productsId"
                               class="btn btn-ghost btn-sm">Edit</a>

                            <form asp-controller="products"
                                  asp-action="Delete"
                                  asp-route-id="@item.productsId"
                                  method="get"
                                  style="display:inline;">
                                <button type="submit" class="btn btn-sm"
                                        style="background:#fde8e8;color:#a0281e;
                                               border:1.5px solid #fde8e8;">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

                <a asp-controller="products" asp-action="Index" class="view-all-link">
                    View All Your Products &rarr;
                </a>
            }
        </div>

<!-- ════════════════
             ORDERS TAB
        ════════════════ -->
<div id="dtab-orders" class="dtab @(ViewBag.activeTab == "orders" ? "active" : "")">
    @{
                var orders = ViewBag.recentOrders as List<GreenfieldLocalHubWebApp.Models.orders>
                             ?? new List<GreenfieldLocalHubWebApp.Models.orders>();
                var userEmails = ViewBag.userEmails as Dictionary<string, string>
                                 ?? new Dictionary<string, string>();
            }

            @if (!orders.Any())
            {
                <div class="empty-state">
                    <p>No recent orders.</p>
                </div>
            }
            else
            {
                <div class="dtab-toolbar">
                    <input type="search" class="form-input" placeholder="Search orders…"
                           style="max-width:240px;" aria-label="Search orders"
                           oninput="filterTable(this,'orders-tbody')">
                    <select class="form-select" style="max-width:190px;" aria-label="Filter by status"
                            onchange="filterByStatus(this,'orders-tbody')">
                        <option value="">All Orders</option>
                        <option>Pending</option>
                        <option>Processing</option>
                        <option>Dispatched</option>
                        <option>Delivered</option>
                        <option>Ready to Collect</option>
                        <option>Collected</option>
                    </select>
                    <span class="toolbar-meta">@orders.Count active orders</span>
                </div>

                <div class="table-wrap">
                    <table class="data-table" role="table" aria-label="Order management table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Order Date</th>
                                <th>Fulfilment</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="orders-tbody">
                            @foreach (var order in orders)
                            {
                                var statusClass = order.orderStatus?.ToLower() switch {
                                    "delivered"        => "delivered",
                                    "dispatched"       => "dispatched",
                                    "processing"       => "processing",
                                    "ready to collect" => "ready",
                                    "collected"        => "collected",
                                    _                  => "pending"
                                };

                                var fulfilmentLabel = order.collection ? "Collection" : "Delivery";
                                var fulfilmentColor = order.collection
                                    ? "color:#1a3a8f;"
                                    : "color:#1a6b40;";

                                var nextStatus = order.collection
                                    ? order.orderStatus switch
                                    {
                                        "Pending"          => "Processing",
                                        "Processing"       => "Ready to Collect",
                                        "Ready to Collect" => "Collected",
                                        _                  => null
                                    }
                                    : order.orderStatus switch
                                    {
                                        "Pending"    => "Processing",
                                        "Processing" => "Dispatched",
                                        "Dispatched" => "Delivered",
                                        _            => null
                                    };

                                var customerEmail = userEmails.TryGetValue(order.UserId, out var email)
                                    ? email : "Unknown";

                                <tr>
                                    <td><strong>#@order.ordersId</strong></td>
                                    <td>
                                        <span style="font-size:.82rem;">@customerEmail</span>
                                    </td>
                                    <td>@order.orderDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="order-status" style="@fulfilmentColor">
                                            @fulfilmentLabel
                                        </span>
                                    </td>
                                    <td>
                                        <span class="order-status @statusClass">
                                            @order.orderStatus
                                        </span>
                                    </td>
                                    <td style="display:flex; gap:.5rem; align-items:center;">
                                        <a asp-controller="orders" asp-action="Details"
                                           asp-route-id="@order.ordersId"
                                           class="btn btn-ghost btn-sm">View</a>

                                        @if (nextStatus != null)
                                        {
                                            <form asp-controller="producerDashboard"
                                                  asp-action="UpdateOrderStatus"
                                                  method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId"
                                                       value="@order.ordersId" />
                                                <button type="submit" class="btn btn-sm"
                                                        style="background:var(--green);
                                                               color:var(--white);">
                                                    → @nextStatus
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <a asp-controller="orders" asp-action="Index" class="view-all-link">
                    View All Your Orders &rarr;
                </a>
            }
        </div>

    </div>
</div>

@section Scripts {
<script>
    /* Tab switching */
    function switchDashTab(btn, tabId) {
        document.querySelectorAll('.dtab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab').forEach(t => {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
        });
        const target = document.getElementById(tabId);
        if (target) target.classList.add('active');
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');
    }

    /* Live search filter */
    function filterTable(input, tbodyId) {
        const q = input.value.toLowerCase();
        document.querySelectorAll('#' + tbodyId + ' tr').forEach(row => {
            row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
    }

    /* Status dropdown filter */
    function filterByStatus(select, tbodyId) {
        const val = select.value.toLowerCase();
        document.querySelectorAll('#' + tbodyId + ' tr').forEach(row => {
            row.style.display = (!val || row.textContent.toLowerCase().includes(val)) ? '' : 'none';
        });
    }
</script>
}
